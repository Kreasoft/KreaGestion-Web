SECRET_KEY=replace-with-a-long-random-production-secret
DEBUG=False
DB_ENGINE=django.db.backends.postgresql
DB_NAME=gestioncloud
DB_USER=gestioncloud
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Correo SMTP (DTE, cotizaciones y compras). Dos formas:
# 1) Empresa → pestaña Datos → usuario y contraseña de correo (recomendado).
# 2) Estas variables (fallback global). Gmail: 2FA + "contraseña de aplicación".
# Sin USER+PASSWORD el mail no llega: Django usa console.EmailBackend.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=tu-correo@gmail.com
EMAIL_HOST_PASSWORD=replace-with-gmail-app-password
DEFAULT_FROM_EMAIL=tu-correo@gmail.com
# Opcional: forzar backend (smtp / console / locmem)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
